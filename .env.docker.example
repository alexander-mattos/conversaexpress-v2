# Copie para .env na raiz do projeto e preencha antes de `docker compose up -d --build`.
# Gere as senhas e segredos com: openssl rand -base64 32

# Domínios (o DNS de ambos precisa apontar para este servidor; portas 80 e 443 abertas)
FRONTEND_DOMAIN=app.seudominio.com.br
BACKEND_DOMAIN=api.seudominio.com.br
# E-mail para o Let's Encrypt (avisos de certificado)
ACME_EMAIL=voce@seudominio.com.br
# Teste local sem certificado público (ex.: localhost e api.localhost): local_certs
CADDY_GLOBAL_OPTIONS=

# Banco e Redis (só na rede interna do compose)
DB_NAME=conversaexpress
DB_USER=conversaexpress
DB_PASS=
REDIS_PASS=

# Autenticação
JWT_SECRET=
JWT_REFRESH_SECRET=

# Opcionais
HOURS_CLOSE_TICKETS_AUTO=24
FRONTEND_EXTRA_ORIGINS=
ENV_TOKEN=
SIGNUP_TRIAL_DAYS=3
USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true
INTEGRATION_ALLOWED_HOSTS=
SENTRY_DSN=

# Asaas (mensalidade das empresas: Pix, boleto e cartão).
# Webhook no painel do Asaas: https://<BACKEND_DOMAIN>/subscription/webhook,
# com o mesmo token de ASAAS_WEBHOOK_TOKEN (gere com: openssl rand -hex 32).
ASAAS_API_KEY=
ASAAS_SANDBOX=false
ASAAS_WEBHOOK_TOKEN=

# E-mail (recuperação de senha)
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_PORT=465
